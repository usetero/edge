{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "exclude-paths": [
        "charts"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "examples/ecs-datadog-sidecar/README.md"
        }
      ]
    },
    "charts/tero-edge": {
      "release-type": "helm",
      "package-name": "tero-edge-chart"
    }
  }
}
